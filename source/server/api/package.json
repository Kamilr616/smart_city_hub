{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "server",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run typecheck && npm run build && node --test tests/*.test.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.vercel.json",
    "dev": "ts-node ./lib/index.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-public.mjs",
    "watch": "node --watch --require ts-node/register ./lib/index.ts",
    "seed:admin": "ts-node ./lib/scripts/seedAdmin.ts"
  },
  "author": "Kamil Rataj",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "1.9.3",
    "@types/node": "^26.6.6",
    "mingo": "^7.2.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
